import org.teavm.gradle.api.JSModuleType
import org.teavm.gradle.api.OptimizationLevel

plugins {
    id "org.teavm" version "0.15.0"
}

dependencies {
    // teavm transpiles :ir's + :stub's pure types -- no gson/net/nio/etc, matching their own
    // zero-dependency policy.
    // tiestone:begin
    // tiestone:end
    implementation project(":stub")
    // SOURCE-retention, so nothing here reaches the bundle. The processor jar is a release asset and
    // carries no transitive metadata, so the annotation types it reads are named beside it.
    githubCompileOnly "intisy:bayonet:1.8.0:annotations"
    githubAnnotationProcessor "intisy:bayonet:1.8.0:processor"
    githubAnnotationProcessor "intisy:bayonet:1.8.0:annotations"
    teavm teavm.libs.jsoApis
}

// The root subprojects{} block pins Java 8 (sourceCompatibility/targetCompatibility +
// compileJava --release 8) for portability of :ir/:stub. TeaVM 0.15.0's own classlib/jso-apis/
// extension-spi artifacts publish a minimum JVM-version metadata of 11-17, so :teavm-stub needs
// a newer compile target than :ir/:stub -- override both the extension's compatibility (fixes
// Gradle's dependency-resolution JVM-version attribute matching) and the compileJava task's
// --release option (which the root block sets via tasks.matching{}.configureEach{}, applied
// before this script runs, last-registered-wins). Mirrors basekit's ir-teavm/build.gradle exactly.
java {
    sourceCompatibility = JavaVersion.VERSION_17
    targetCompatibility = JavaVersion.VERSION_17
}

tasks.named("compileJava") {
    options.release = 17
    options.compilerArgs << "-Atsemit.name=stub-translator.teavm"
}

teavm.js {
    mainClass = "io.github.intisy.ai.js.StubTranslatorJs"
    moduleType = JSModuleType.ES2015
    obfuscated = false
    optimization = OptimizationLevel.NONE
    targetFileName = "stub-translator.js"
}
